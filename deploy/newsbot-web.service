[Unit]
Description=Personal news ranking and Telegram ratings web UI
After=newsbot.service

[Service]
User=newsbot
Group=newsbot
WorkingDirectory=/opt/newsbot
EnvironmentFile=/etc/newsbot.env
ExecStart=/opt/newsbot/.venv/bin/python -m newsbot web
Restart=on-failure
RestartSec=10
UMask=0077
StateDirectory=newsbot
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
